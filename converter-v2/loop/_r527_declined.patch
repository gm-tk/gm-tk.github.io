+	/** ROUND 527 — is items[j] (with the rest of its paragraph) a journal instruction naming an activity id? The item's own
+	 *  text — a black line, or a button / body / tag-less red span's bracket words + black tail — plus every later item on the same
+	 *  block, brackets and the leading tag word stripped, tested with r522's journal_instruction_box patterns. */
+	static #isJournalInstruction(items, j, cfg) {
+		const it = items[j];
+		if (!it || (it.type !== "black" && it.type !== "tag")) return false;
+		if (it.type === "tag") {
+			const p = it.parse?.primary;
+			if (p && !["button", "body", "body text", "learning journal"].includes(String(p.tag))) return false;
+		}
+		const piece = (x) => x.type === "black" ? String(x.text ?? "") : `${String(x.text ?? "")} ${String(x.blackAfter ?? "")}`;
+		let text = piece(it);
+		for (let k = j + 1; k < items.length && items[k]?.block && items[k].block === it.block; k++) text += " " + piece(items[k]);
+		text = text.replace(/\[\s*(?:button|body(?: text)?|learning journal)\s*:?\s*\]?/gi, " ").replace(/[[\]{}*]/g, " ").replace(/\s+/g, " ").trim();
+		const w = text.split(" ").filter(Boolean).length;
+		if (w < (cfg.min_words ?? 5) || w > (cfg.max_words ?? 40)) return false;
+		return new RegExp(cfg.journal_pattern, "i").test(text) && new RegExp(cfg.verb_pattern, "i").test(text)
+			&& new RegExp(cfg.id_pattern, "i").test(text);
+	}
